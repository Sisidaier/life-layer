# mock: no Apple access, useful for UI development
# applescript: writes to the local macOS Calendar / Reminders apps
# shortcuts: runs the macOS Shortcut named below
LIFE_LAYER_BRIDGE=mock
LIFE_LAYER_SHORTCUT_NAME=Life Layer Bridge
LIFE_LAYER_TIMEZONE=Asia/Shanghai
LIFE_LAYER_DEFAULT_CALENDAR=
LIFE_LAYER_DEFAULT_REMINDERS_LIST=
LIFE_LAYER_EXECUTION_MODE=macos
NEXT_PUBLIC_LIFE_LAYER_EXECUTION_MODE=macos
NEXT_PUBLIC_LIFE_LAYER_SHORTCUT_NAME=Life Layer Bridge

# The deterministic Golden Path parser works without an API key.
LIFE_LAYER_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional alternative provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
